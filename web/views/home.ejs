<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="min-h-screen pb-36">
<% const h = hero; %>
<section class="relative px-6 md:px-12 pt-10 pb-20 overflow-hidden">
<div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
<div class="lg:col-span-7 z-10">
<span class="inline-block px-4 py-1 rounded-full bg-tertiary-container text-tertiary font-label text-xs tracking-widest uppercase mb-4">Bu akşam</span>
<h1 class="font-headline italic text-4xl md:text-6xl lg:text-7xl text-on-background leading-tight mb-4">
<% if (h) { %>
  <span class="text-on-surface"><%= h.title %></span>
<% } else { %>
  The Echoes of <br/><span class="text-primary">Stellar Wind</span>
<% } %>
</h1>
<p class="font-body text-base md:text-lg text-on-surface-variant max-w-xl mb-8 leading-relaxed">
<% if (h && h.description) { %><%= h.description.substring(0, 220) %><%= h.description.length > 220 ? '…' : '' %><% } else { %>Sesli kitap koleksiyonunuzu keşfedin. Wirbooks API ile canlı veri.<% } %>
</p>
<div class="flex flex-wrap gap-4">
<% if (h) { %>
<a href="/play/<%= h.id %>" class="h-14 px-8 rounded-full bg-secondary text-on-secondary font-semibold flex items-center gap-3 hover:shadow-[0_20px_40px_rgba(251,180,0,0.2)] transition-all no-underline">
<span class="material-symbols-outlined" style="font-variation-settings:'FILL'1">play_arrow</span>Dinlemeye başla</a>
<a href="/book/<%= h.id %>" class="h-14 px-8 rounded-full border border-outline-variant/30 text-on-surface font-semibold flex items-center gap-3 hover:bg-surface-container transition-all no-underline">Detay</a>
<% } else { %>
<a href="/search" class="h-14 px-8 rounded-full bg-secondary text-on-secondary font-semibold flex items-center gap-3 no-underline">Keşfet</a>
<% } %>
</div>
</div>
<div class="lg:col-span-5 relative">
<div class="aspect-[3/4] rounded-xl overflow-hidden shadow-2xl md:scale-105 md:rotate-3 hover:rotate-0 transition-transform duration-700 bg-surface-container">
<% if (h && h.cover) { %>
<img class="w-full h-full object-cover" alt="" src="<%= h.cover %>"/>
<% } else { %>
<div class="w-full h-full bg-gradient-to-br from-primary-container to-surface-container-highest"></div>
<% } %>
</div>
<div class="absolute -z-10 -bottom-10 -right-10 w-64 h-64 bg-secondary/10 blur-[100px] rounded-full"></div>
</div>
</div>
</section>

<section class="px-6 md:px-12 py-14 bg-surface-container-low">
<div class="max-w-[1600px] mx-auto">
<div class="flex justify-between items-end mb-8">
<div>
<h2 class="font-headline text-3xl md:text-4xl italic text-on-background mb-2">Önerilenler</h2>
<p class="text-on-surface-variant text-xs uppercase tracking-widest">API: öne çıkanlar</p>
</div>
<a href="/search" class="text-primary hover:text-tertiary transition-colors flex items-center gap-2 font-semibold text-sm">Tümü <span class="material-symbols-outlined text-sm">arrow_forward</span></a>
</div>
<% if (error) { %><p class="text-tertiary">API'ye bağlanılamadı. .env içinde API_BASE kontrol edin.</p><% } %>
<div class="flex gap-6 overflow-x-auto no-scrollbar pb-6">
<% featured.forEach(function(b) { %>
<a href="/book/<%= b.id %>" class="flex-none w-52 group no-underline">
<div class="aspect-[2/3] rounded-xl overflow-hidden mb-3 bg-surface-container relative">
<% if (b.cover) { %><img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="" src="<%= b.cover %>"/><% } %>
<div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
<span class="material-symbols-outlined text-secondary text-3xl" style="font-variation-settings:'FILL'1">play_circle</span>
</div>
</div>
<h3 class="text-on-surface font-semibold truncate"><%= b.title %></h3>
<p class="text-on-surface-variant text-sm truncate"><%= b.author %></p>
</a>
<% }); %>
</div>
</div>
</section>

<section class="px-6 md:px-12 py-20">
<div class="max-w-[1600px] mx-auto">
<h2 class="font-headline text-3xl md:text-4xl italic text-on-background mb-10">Popüler</h2>
<div class="flex gap-6 overflow-x-auto no-scrollbar pb-6">
<% popular.forEach(function(b) { %>
<a href="/book/<%= b.id %>" class="flex-none w-48 group no-underline">
<div class="aspect-[2/3] rounded-xl overflow-hidden mb-3 bg-surface-container">
<% if (b.cover) { %><img class="w-full h-full object-cover group-hover:scale-105 transition-transform" alt="" src="<%= b.cover %>"/><% } %>
</div>
<h3 class="text-on-surface font-semibold text-sm truncate"><%= b.title %></h3>
<p class="text-on-surface-variant text-xs truncate"><%= b.author %> · <%= formatDur(b.durationSec) %></p>
</a>
<% }); %>
</div>
</div>
</section>

<% if (categories && categories.length) { %>
<section class="px-6 md:px-12 py-16 bg-surface-container-lowest">
<div class="max-w-[1600px] mx-auto">
<h2 class="font-headline text-3xl italic text-on-background mb-10">Kategoriler</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<% categories.slice(0,3).forEach(function(c, i) { %>
<a href="/search?category=<%= encodeURIComponent(c.slug) %>" class="relative group rounded-xl overflow-hidden bg-surface-container-high min-h-[180px] flex flex-col justify-end p-8 no-underline <%= i === 0 ? 'md:col-span-2 md:min-h-[240px]' : '' %>">
<span class="relative z-10 font-headline text-2xl md:text-3xl text-on-surface mb-1"><%= c.name %></span>
<span class="relative z-10 text-on-surface-variant text-xs">Keşfet →</span>
<div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
</a>
<% }); %>
</div>
</div>
</section>
<% } %>
</main>
<%- include('partials/bottom-nav') %>
<%- include('partials/foot') %>

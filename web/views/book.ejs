<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="max-w-[1400px] mx-auto px-6 md:px-12 py-10 md:py-16 pb-36">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
<div class="lg:col-span-5 flex justify-center lg:justify-end">
<div class="relative group max-w-[400px] w-full">
<div class="absolute inset-0 bg-primary-container rounded-xl blur-3xl opacity-20 group-hover:opacity-40 transition-opacity"></div>
<% if (book.cover) { %>
<img alt="" src="<%= book.cover %>" class="relative z-10 w-full aspect-[2/3] object-cover rounded-xl shadow-[0_40px_60px_rgba(0,0,0,0.5)] transition-transform duration-500 group-hover:scale-[1.02]"/>
<% } else { %>
<div class="relative z-10 w-full aspect-[2/3] rounded-xl bg-surface-container-highest"></div>
<% } %>
<div class="absolute -bottom-4 -right-4 z-20 glass-panel p-4 rounded-xl border border-outline-variant/10">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-secondary text-lg" style="font-variation-settings:'FILL'1">star</span>
<span class="font-bold text-lg text-on-surface"><%= book.rating || '—' %></span>
</div>
</div>
</div>
</div>
<div class="lg:col-span-7 flex flex-col gap-6">
<header>
<% if (book.categoryName) { %><span class="text-on-surface-variant text-sm"><%= book.categoryName %></span><% } %>
<h1 class="font-headline text-4xl md:text-6xl text-primary leading-tight mt-2"><%= book.title %></h1>
<p class="text-xl text-on-surface-variant mt-2"><%= book.author %></p>
<% if (book.narrator) { %><p class="text-sm text-on-surface-variant/70 italic mt-1">Seslendiren: <%= book.narrator %></p><% } %>
</header>
<div class="flex flex-wrap gap-3 items-center">
<a href="/play/<%= book.id %>" class="h-14 px-8 bg-secondary text-on-secondary rounded-full font-bold flex items-center gap-2 hover:shadow-[0_0_20px_rgba(251,180,0,0.3)] transition-all no-underline">
<span class="material-symbols-outlined" style="font-variation-settings:'FILL'1">play_circle</span>Dinle</a>
<button type="button" id="btn-fav" data-book-id="<%= book.id %>" class="w-14 h-14 bg-surface-container-low text-on-surface-variant rounded-full flex items-center justify-center hover:bg-surface-container border border-outline-variant/10" aria-label="Favori">♡</button>
</div>
<div class="bg-surface-container-low p-6 md:p-8 rounded-xl space-y-4">
<div class="flex flex-wrap gap-8 text-sm text-on-surface-variant uppercase tracking-widest font-semibold">
<div><span class="text-[10px] opacity-50 block">Süre</span><span class="text-on-surface normal-case"><%= formatDur(book.durationSec) %></span></div>
</div>
<% if (book.description) { %>
<p class="text-on-surface-variant leading-relaxed text-base border-t border-outline-variant/10 pt-6"><%= book.description %></p>
<% } %>
</div>
<section class="mt-12">
<h2 class="font-headline text-2xl text-primary mb-4">Bölümler</h2>
<% if (!chapters.length) { %><p class="text-on-surface-variant">Bölüm yok.</p><% } else { %>
<ul class="space-y-2 list-none p-0">
<% chapters.forEach(function(ch, idx) { %>
<li>
<a href="/play/<%= book.id %>?chapter=<%= ch.id %>" class="flex justify-between items-center p-4 rounded-xl hover:bg-surface-container transition-colors no-underline text-on-surface border border-transparent hover:border-outline-variant/10">
<span class="font-medium"><%= idx+1 %>. <%= ch.title %></span>
<span class="text-on-surface-variant text-sm"><%= formatDur(ch.durationSec) %></span>
</a>
</li>
<% }); %>
</ul>
<% } %>
</section>
</div>
</div>
</main>
<%- include('partials/bottom-nav') %>
<script>window.__ML_PAGE = 'book';</script>
<%- include('partials/foot') %>

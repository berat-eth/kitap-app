<header class="w-full top-0 sticky z-50 bg-[#101b30] transition-colors duration-500">
<div class="flex justify-between items-center px-6 md:px-12 py-6 max-w-[1920px] mx-auto">
<div class="flex items-center gap-8 md:gap-12">
<a href="/" class="font-serif italic text-xl md:text-2xl text-primary tracking-tight no-underline text-primary">Wirbooks</a>
<nav class="hidden md:flex items-center gap-8">
<a href="/" class="text-sm <%= activeTop === 'discover' ? 'text-primary border-b-2 border-tertiary pb-1 font-semibold' : 'text-on-surface/60 hover:text-on-surface' %>">Keşfet</a>
<a href="/library" class="text-sm <%= activeTop === 'library' ? 'text-primary border-b-2 border-tertiary pb-1 font-semibold' : 'text-on-surface/60 hover:text-on-surface' %>">Kitaplığım</a>
<a href="/search" class="text-sm text-on-surface/60 hover:text-on-surface">Ara</a>
</nav>
</div>
<div class="flex items-center gap-4 md:gap-6">
<form action="/search" method="get" class="hidden lg:flex items-center bg-surface-container-lowest px-4 py-2 rounded-lg outline outline-1 outline-outline-variant/15">
<span class="material-symbols-outlined text-on-surface-variant text-sm">search</span>
<input name="q" class="bg-transparent border-none focus:ring-0 text-sm w-48 md:w-64 placeholder:text-on-surface-variant/50 text-on-surface" placeholder="Hikâye ara..." type="search"/>
</form>
<div class="flex items-center gap-3 text-primary">
<button type="button" class="hover:text-tertiary transition-colors scale-95 active:scale-90" aria-label="Bildirimler"><span class="material-symbols-outlined">notifications</span></button>
<button type="button" class="hover:text-tertiary transition-colors scale-95 active:scale-90" aria-label="Hesap"><span class="material-symbols-outlined">account_circle</span></button>
</div>
</div>
</div>
</header>
